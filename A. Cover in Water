#include<bits/stdc++.h>
using namespace std;

int main(){
    int t; cin>>t;
    while(t--){
        int n; cin>>n;
        string s; cin>>s;
        int cnt1=0,cnt2=0;
        for(int i=0;i<s.size();i++){
            if(s[i]=='#') cnt1=0;
            if(s[i]=='.') {
                cnt1++;
                cnt2++;
            }
            if(cnt1==3) break;
        }
        if(cnt1==3) cout<<2<<endl;
        else cout<<cnt2<<endl;
        
    }
}
